<sect1 id="loupe" xreflabel="Loupe-&loupe-version;">
  <?dbhtml filename="loupe.html"?>


  <title>Loupe-&loupe-version;</title>

  <indexterm zone="loupe">
    <primary sortas="a-Loupe">Loupe</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Loupe</title>

    <para>
      <application>Loupe</application> er et program som brukes til å vise 
      bildefiler på <application>GNOME</application> Skrivebordet.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&loupe-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&loupe-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &loupe-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &loupe-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &loupe-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &loupe-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Loupe Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref role="runtime" linkend="glycin"/> (kjøretid),
      <xref linkend="lcms2"/>,
      <xref linkend="libadwaita1"/>,
      <xref linkend="libgweather"/>,
      <xref linkend="libseccomp"/>, og
      <xref linkend="rust"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="appstream"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Loupe</title>

    <para>
      Installer <application>Loupe</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            ..                  &amp;&amp;
ninja</userinput></screen>

    <para>
      Å kjøre testpakken vil gjenoppbygge hele pakken med en annen 
      konfigurasjon, og pakken vil bli bygget tre ganger hvis du installerer 
      den etter å ha kjørt testpakken. Så det er bedre å kjøre testpakken etter 
      installasjonen.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>ninja test</command>
    </para>

  </sect2>

