<sect1 id="showtime" xreflabel="Showtime-&showtime-version;">
  <?dbhtml filename="showtime.html"?>

  <title>Showtime-&showtime-version;</title>

  <indexterm zone="showtime">
    <primary sortas="a-Showtime">Showtime</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Showtime</title>

    <para>
      <application>Showtime</application> er et program som brukes til å spille 
      av lyd og videofiler på <application>GNOME</application>
      skrivebordet.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&showtime-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&showtime-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &showtime-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &showtime-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &showtime-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &showtime-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Showtime Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="blueprint-compiler"/>,
      <xref linkend="gst10-plugins-base"/>,
      <xref linkend="libadwaita1"/>, og
      <xref linkend="pygobject3"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Showtime</title>

    <para>
      Installer <application>Showtime</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            ..                  &amp;&amp;
ninja</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
