  <sect2 role="package">
    <title>Introduksjon til GNOME Brukerdokumenter</title>

    <para>
      <application>GNOME Brukerdokumenter</application> pakken inneholder
      dokumentasjon for <application>GNOME</application>.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&gnome-user-docs-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&gnome-user-docs-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &gnome-user-docs-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &gnome-user-docs-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &gnome-user-docs-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &gnome-user-docs-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">GNOME Brukerdokumenter Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="itstool"/> og
      <xref linkend="libxml2"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="https://gitlab.gnome.org/GNOME/yelp-tools"/> (for tests)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av GNOME Brukerdokumenter</title>

    <para>
      Installer <application>GNOME Brukerdokumenter</application> ved å kjøre
      følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup  --prefix=/usr -D tests=false .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Tester for denne pakken krever den valgfrie yelp-tools-pakken.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

