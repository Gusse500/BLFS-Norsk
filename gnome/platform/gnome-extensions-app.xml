<sect1 id="gnome-extensions-app" xreflabel="gnome-extensions-app-&gnome-extensions-app-version;">
  <?dbhtml filename="gnome-extensions-app.html"?>


  <title>gnome-extensions-app-&gnome-extensions-app-version;</title>

  <indexterm zone="gnome-extensions-app">
    <primary sortas="a-gnome-extensions-app">gnome-extensions-app</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til GNOME Extensions App</title>

    <para>
      <application>GNOME Extensions App</application> pakken inneholder
      en grafisk administrator for GNOME Shell Extensions.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&gnome-extensions-app-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&gnome-extensions-app-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &gnome-extensions-app-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &gnome-extensions-app-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &gnome-extensions-app-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &gnome-extensions-app-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">GNOME Extensions App Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="gjs"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av GNOME Extensions App</title>

    <para>
      Installer <application>GNOME Extensions App</application> ved å kjøre
      følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr ..</userinput></screen>

    <para>
      Denne pakken kommer ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

