      <xref linkend="qt6"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av qtkeychain</title>

    <para>
      Installer <application>qtkeychain</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=$QT6DIR \
      -D CMAKE_BUILD_TYPE=Release     \
      -D BUILD_WITH_QT6=ON            \
      -D BUILD_TESTING=OFF            \
      -W no-author ..                 &amp;&amp;
make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

