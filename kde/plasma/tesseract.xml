<sect1 id="tesseract" xreflabel="tesseract-&tesseract-version;">
  <?dbhtml filename="tesseract.html"?>

  <title>tesseract-&tesseract-version;</title>

  <indexterm zone="tesseract">
    <primary sortas="a-tesseract-&tesseract-version;">tesseract</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til tesseract</title>

    <para>
      <application>tesseract</application> pakken inneholder en optisk 
      tegngjenkjenningsmotor (OCR) og et kommandolinjeprogram som brukes til å 
      trekke ut trykt tekst fra bilder. 
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&tesseract-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&tesseract-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &tesseract-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastningsstørrelse: &tesseract-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &tesseract-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &tesseract-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">tesseract Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="requrired">
      <xref linkend="leptonica"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="curl"/>,
      <xref linkend="icu"/>,
      <xref linkend="libarchive"/>, og
      <xref linkend="pango"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av tesseract</title>

    <para>
      Installer <application>tesseract</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>./autogen.sh &amp;&amp;           

./configure --prefix=/usr --disable-static &amp;&amp;
make</userinput></screen>

    <para>
      Pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

