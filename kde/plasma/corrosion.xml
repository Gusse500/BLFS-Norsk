  <sect2 role="package">
    <title>Introduksjon til corrosion</title>

    <para>
      <application>corrosion</application> pakken er et verktøy for å integrere 
      <xref linkend="rustc"/> inn i et eksisterende CMake prosjekt.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&corrosion-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&corrosion-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &corrosion-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastningsstørrelse: &corrosion-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &corrosion-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &corrosion-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">corrosion Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="rustc"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av corrosion</title>

    <para>
      Installer <application>corrosion</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr    \
      -D CMAKE_BUILD_TYPE=Release     \
      -D CMAKE_INSTALL_LIBEXECDIR=lib \
      -D CORROSION_BUILD_TESTS=OFF    \
      -W no-author ..                 &amp;&amp;
make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

