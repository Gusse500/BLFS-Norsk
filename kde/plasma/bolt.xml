<sect1 id="bolt" xreflabel="bolt-&bolt-version;">
  <?dbhtml filename="bolt.html"?>

  <title>bolt-&bolt-version;</title>

  <indexterm zone="bolt">
    <primary sortas="a-bolt-&bolt-version;">bolt</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til bolt</title>

    <para>
      <application>bolt</application> pakken er en systemdaemon for å aktivere 
      sikkerhetsnivåer for Thunderbolt.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&bolt-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&bolt-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &bolt-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &bolt-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &bolt-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &bolt-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">bolt Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="glib2"/> og
      <xref linkend="polkit"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="umockdev"/> (for testing), og
      <xref linkend="asciidoc"/> (for dokumentasjon)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av bolt</title>

    <para>
      Installer <application>bolt</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      For å teste resultatene, utsted:  <command>ninja test</command>.
      En test, test_journal_object, er kjent for å feile.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

