<sect1 id="kddockwidgets" xreflabel="KDDockWidgets-&kddockwidgets-version;">
  <?dbhtml filename="kddockwidgets.html"?>

  <title>KDDockWidgets-&kddockwidgets-version;</title>

  <indexterm zone="kddockwidgets">
    <primary sortas="a-KDDockWidgets">KDDockWidgets</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til KDDockWidgets</title>

    <para>
      <application>KDDockWidgets</application> pakken inneholder Qt dock 
      widgeter som er egnet for å erstatte QDockWidget og implementere avansert 
      funksjonalitet som mangler i Qt.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&kddockwidgets-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&kddockwidgets-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &kddockwidgets-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &kddockwidgets-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &kddockwidgets-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &kddockwidgets-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">KDDockWidgets Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="fmt"/>,
      <xref linkend="qt6"/>, og
      <xref linkend="vulkan-loader"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="nlohmann-json"/>,
      <ulink url="https://github.com/KDAB/KDBindings">KDBindings</ulink>, og
      <ulink url="https://github.com/gabime/spdlog">spdlog</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av KDDockWidgets</title>

    <para>
      Installer <application>KDDockWidgets</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \
      -D CMAKE_BUILD_TYPE=Release         \
      -W no-author .. &amp;&amp;
make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

