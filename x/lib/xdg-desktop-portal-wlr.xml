<sect1 id="xdg-desktop-portal-wlr" xreflabel="xdg-desktop-portal-wlr-&xdg-desktop-portal-wlr-version;">
  <?dbhtml filename="xdg-desktop-portal-wlr.html"?>

  <title>xdg-desktop-portal-wlr-&xdg-desktop-portal-wlr-version;</title>

  <indexterm zone="xdg-desktop-portal-wlr">
    <primary sortas="a-xdg-desktop-portal-wlr">xdg-desktop-portal-wlr</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til xdg-desktop-portal-wlr</title>

    <para>
      Pakken xdg-desktop-portal-wlr tilbyr skjermbilde og skjermopptaks 
      portalgrensesnittene for wlroots kompositore. De fleste andre 
      portalgrensesnittene leveres av <xref linkend="xdg-desktop-portal-gtk"/>, 
      men er ikke strengt tatt påkrevd med mindre du trenger disse grensesnittene
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&xdg-desktop-portal-wlr-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &xdg-desktop-portal-wlr-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &xdg-desktop-portal-wlr-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &xdg-desktop-portal-wlr-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &xdg-desktop-portal-wlr-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">xdg-desktop-portal-wlr Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="mesa"/>,
      <xref linkend="inih"/>,
      <xref linkend="libdrm"/>,
      <phrase revision='sysv'><xref linkend="elogind"/>,</phrase>
      <phrase revision='systemd'><xref linkend="systemd"/>,</phrase>
      <xref linkend="pipewire"/>,
      <xref linkend="wayland"/>,
      <xref linkend="wayland-protocols"/>, og
      <xref linkend="xdg-desktop-portal"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="xdg-desktop-portal-gtk"/> (for å tilby de fleste 
      portalgrensesnittene som å hente den foretrukne filbehandleren)
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="/slfs/view/dev/general/scdoc.html">scdoc</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av xdg-desktop-portal-wlr</title>

    <para>
      Installer xdg-desktop-portal-wlr ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Denne pakken kommer ikke med en testpakke.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

    <para>
      Sørg for at portalen kan oppdages som &root; bruker:
    </para>

<screen
  role="root"><userinput>cat &gt; /usr/share/xdg-desktop-portal/wlr-portals.conf &lt;&lt; "EOF"
<literal>[preferred]
default=wlr</literal>
EOF</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
