<sect1 id="wayfire-plugins-extra" xreflabel="wayfire-plugins-extra-&wayfire-plugins-extra-version;">
  <?dbhtml filename="wayfire-plugins-extra.html"?>

  <title>wayfire-plugins-extra-&wayfire-plugins-extra-version;</title>

  <indexterm zone="wayfire-plugins-extra">
    <primary sortas="a-wayfire-plugins-extra">wayfire-plugins-extra</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til wayfire-plugins-extra</title>

    <para>
      Pakken wayfire-plugins-extra tilbyr flere programtillegg for <xref
      linkend="wayfire"/> som du kanskje ønsker eller trenger. For eksempel, for 
      fokus følger musen, trenger du <filename
      class="libraryfile">follow-focus</filename> programtillegget fra denne pakken.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&wayfire-plugins-extra-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &wayfire-plugins-extra-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &wayfire-plugins-extra-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &wayfire-plugins-extra-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &wayfire-plugins-extra-time;
        </para>
      </listitem>
    </itemizedlist>

<!--
    <bridgehead renderas="sect3">Ytterligere nedlastinger</bridgehead>
