<sect1 id="wayfire" xreflabel="wayfire-&wayfire-version;">
  <?dbhtml filename="wayfire.html"?>

  <title>wayfire-&wayfire-version;</title>

  <indexterm zone="wayfire">
    <primary sortas="a-wayfire">wayfire</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til wayfire</title>

    <para>
      Wayfire er en Wayland kompositor som tar mange effekter fra den nå 
      utdaterte Compiz Xorg kompositoren. Den har som mål å være tilpassbar, 
      men likevel lettvektig. I motsetning til andre kompositorer er den også 
      3D og støtter flere perspektiver for å se vinduer.
    </para>

    &build-use-internet;

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&wayfire-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &wayfire-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &wayfire-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &wayfire-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &wayfire-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Wayfire Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="glm"/>,
      <xref linkend="freetype2"/>,
      <xref linkend="libdrm"/>,
      <xref linkend="libevdev"/>,
      <xref linkend="libinput"/>,
      <xref linkend="libjpeg"/>,
      <xref linkend="libpng"/>,
      <xref linkend="libxkbcommon"/>,
      <xref linkend="mesa"/>,
      <xref linkend="nlohmann-json"/>,
      <xref linkend="pango"/> (med Cairo),
      <xref linkend="pixman"/>,
      <xref linkend="wayland"/>,
      <xref linkend="wayland-protocols"/>,
      <xref linkend="wlroots"/>, og
      <xref linkend="yyjson"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="xorg7-lib"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="doxygen"/>,
      <xref linkend="libnotify"/>,
      <ulink url="https://github.com/doctest/doctest">doctest</ulink> (for
      tester), og
      <ulink url="https://github.com/juniorrantila/libinotify">libinotify</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Wayfire</title>

    <para>
      Installer Wayfire ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

    <para>
      Fjern noen ubrukelige statiske biblioteker som &root; bruker:
    </para>

<screen role="root"><userinput>rm -vf /usr/lib/libwftouch.a \
       /usr/lib/libwayfire-{move-drag-interface,workspace-wall}.a</userinput></screen>

    <para>
      Kopier standard konfigurasjonsfil til <filename
      class="directory">/usr/share/wayfire</filename> som &root; bruker:
    </para>

<screen role="root"><userinput>cp -v ../wayfire.ini /usr/share/wayfire</userinput></screen>

  </sect2>

  <sect2 role="configuration">
    <title>Konfigurere Wayfire</title>

    <sect3 id="wayfire-config">
      <title>Konfigurasjonsfiler</title>
      <para>
        <filename>~/.config/wayfire.ini</filename>. Standardversjonen er 
        i <filename class="directory">/usr/share/wayfire</filename> og vil 
        ikke bli brukt og må kopieres til
        <filename class="directory">~/.config</filename>
      </para>

      <indexterm zone="wayfire wayfire-config">
        <primary sortas="e-AA.config">~/.config/wayfire.ini</primary>
      </indexterm>

    </sect3>

    <sect3><title>Konfigurasjonsinformasjon</title>

      <para>
        Kopier standard konfigurasjonsfil:
      </para>

<screen><userinput>cp /usr/share/wayfire/wayfire.ini ~/.config</userinput></screen>

      <para>
        Nå kan du inspisere filen og gjøre eventuelle endringer som passer til 
        arbeidsflyten din. Hvis du trenger å vite hvilke programtillegg som er 
        installert, kan du se på listen over installerte programtillegg nedenfor.
      </para>

    </sect3>

  </sect2>

