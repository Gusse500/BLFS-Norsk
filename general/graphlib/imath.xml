<sect1 id="imath" xreflabel="Imath-&Imath-version;">
  <?dbhtml filename="imath.html"?>

  <title>Imath-&Imath-version;</title>

  <indexterm zone="imath">
    <primary sortas="a-Imath-&Imath-version;">Imath</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Imath</title>

    <para>
      <application>Imath</application> er et C++ og Python bibliotek med 2D og 
      3D vektor, matrise og matematiske operasjoner for datagrafikk.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&Imath-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&Imath-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &Imath-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &Imath-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &Imath-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &Imath-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Imath Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="cmake"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="boost"/> og
      <xref linkend="numpy"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Imath</title>

    <para>
      Installer <application>Imath</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D PYTHON=ON                 \
      ..  &amp;&amp;
make</userinput></screen>

    <para>
      For å teste resultatene, utsted:  <command>make test</command>.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <parameter>-D PYTHON=ON</parameter>: Dette alternativet aktiverer bygging 
      av Python modulene. Det kan deaktiveres hvis
      <xref linkend="numpy"/> ikke er installert.
    </para>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>Ingen</seg>
        <seg>
          libImath.so,
          libImath-3_2.so,
          libPyImath.so, og
          libPyImath_Python3_14-3_2.so
        </seg>
        <seg>
          /usr/include/Imath og 
          /usr/lib/cmake/Imath
        </seg>
      </seglistitem>
    </segmentedlist>

