<sect1 id="pdfio" xreflabel="pdfio-&pdfio-version;">
  <?dbhtml filename="pdfio.html"?>

  <title>pdfio-&pdfio-version;</title>

  <indexterm zone="pdfio">
    <primary sortas="a-pdfio">pdfio</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til pdfio</title>

    <para>
      <application>pdfio</application> Pakken inneholder et enkelt C-bibliotek 
      for lesing og skriving av PDF filer.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&pdfio-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&pdfio-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &pdfio-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &pdfio-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &pdfio-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &pdfio-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">pdfio Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="libpng"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av pdfio</title>

    <para>
      Installer <application>pdfio</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr    \
            --disable-static \
            --enable-shared  &amp;&amp;
make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install &amp;&amp;
mv -v /usr/share/doc/pdfio{,-&pdfio-version;}
</userinput></screen>

  </sect2>

