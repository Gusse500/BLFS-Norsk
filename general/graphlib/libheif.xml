  <sect2 role="installation">
    <title>Installasjon av libheif</title>

<!--
    <para>
      Først, fiks byggingen av libheif hvis du skal aktivere SVT-AV1 
      koderen:
    </para>

<screen><userinput remap="pre">patch -Np1 -i ../libheif-&libheif-version;-svt_av1_build_fix-2.patch</userinput></screen>
-->

    <para>
      Installer <application>libheif</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D WITH_GDK_PIXBUF=OFF       \
      -D WITH_OpenH264_DECODER=OFF \
      -G Ninja ..                  &amp;&amp;
ninja</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>ninja test</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>
  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <parameter>-D WITH_GDK_PIXBUF=OFF</parameter>: Dette alternativet 
      deaktiverer bygging av gdk-pixbuf-lasteren, ettersom <xref linkend='gdk-pixbuf'/> 
      skal bruke denne pakken via <xref linkend='glycin'/> i stedet for 
      lasteren.
    </para>

    <!-- The intention is only listing an option if the dependency is
         in BLFS and it's not enabled by default even if the dependency is
         installed.  -->

    <para>
      <option>-D WITH_DAV1D=ON</option>: Dette alternativet tillater bruk av
      <xref linkend='dav1d'/> for å dekode AV1 data i AVIF filer.
    </para>

    <para>
      <option>-D WITH_FFMPEG_DECODER=ON</option>: Dette alternativet tillater 
	  bruk av <xref linkend='ffmpeg'/> for å dekode H.265 data i HEIC filer.
    </para>

    <para>
      <option>-D WITH_JPEG_ENCODER=ON -D WITH_JPEG_DECODER=ON</option>: Dette 
	  alternativet tillater bruk av <xref linkend='libjpeg'/> for å kode og 
	  dekode HEIF filer med JPEG data.
    </para>

    <para>
      <option>-D WITH_OpenJPEG_ENCODER=ON -D WITH_OpenJPEG_DECODER=ON</option>:
      Dette alternativet tillater bruk av <xref linkend='openjpeg2'/> for å kode 
      og dekode HEIF filer med JPEG 2000 data.
    </para>

    <para>
      <option>-D WITH_SvtEnc=ON</option>: Dette alternativet tillater bruk av
      <xref linkend='svt-av1'/> for å kode AV1 data for AVIF filer.
    </para>
  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          heif-convert (symbolsk lenke til heif-dec), heif-dec, heif-enc, 
          heif-info, heif-thumbnailer (hvis libpng er tilgjengelig), og 
          heif-view (hvis SDL2 er tilgjengelig)
        </seg>
        <seg>
          libheif.so
        </seg>
        <seg>
          /usr/include/libheif, /usr/lib/libheif, og
          /usr/lib/cmake/libheif
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="heif-dec">
        <term><command>heif-dec</command></term>
        <listitem>
          <para>
            dekoder et HEIC/HEIF bilder
          </para>
          <indexterm zone="libheif heif-dec">
            <primary sortas="b-heif-dec">heif-dec</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="heif-enc">
        <term><command>heif-enc</command></term>
        <listitem>
          <para>
            konverterer et bilde til HEIC/HEIF
          </para>
          <indexterm zone="libheif heif-enc">
            <primary sortas="b-heif-enc">heif-enc</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="heif-info">
        <term><command>heif-info</command></term>
        <listitem>
          <para>
            viser informasjon om en HEIC/HEIF fil
          </para>
          <indexterm zone="libheif heif-info">
            <primary sortas="b-heif-info">heif-info</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="heif-thumbnailer">
        <term><command>heif-thumbnailer</command></term>
        <listitem>
          <para>
            lager miniatyrbilder fra HEIC/HEIF filer
          </para>
          <indexterm zone="libheif heif-thumbnailer">
            <primary sortas="b-heif-thumbnailer">heif-thumbnailer</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="heif-view">
        <term><command>heif-view</command></term>
        <listitem>
          <para>
            viser et bilde i HEIC/HEIF format med SDL2
          </para>
          <indexterm zone="libheif heif-view">
            <primary sortas="b-heif-view">heif-view</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libheif-lib">
        <term><filename class="libraryfile">libheif.so</filename></term>
        <listitem>
          <para>
            er en ISO/IEC 23008-12:2017 HEIF og AVIF filformatdekoder og 
            koder (AV1 Bildefilformat)
          </para>
          <indexterm zone="libheif libheif-lib">
            <primary sortas="c-libheif">libheif.so</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>
  </sect2>
