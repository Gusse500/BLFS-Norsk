  <!--Required section-->
  <sect2 role="package">
    <title>Introduksjon til libheif</title>

    <para>
      <application>libheif</application> Pakken er en dekoder og koder for 
      HEIF og AVIF filformater.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&libheif-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &libheif-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &libheif-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &libheif-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &libheif-time;
        </para>
      </listitem>
    </itemizedlist>

