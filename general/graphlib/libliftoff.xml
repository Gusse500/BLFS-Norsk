    <primary sortas="a-libliftoff">libliftoff</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libliftoff</title>

    <para>
      Pakken libliftoff tilbyr et bibliotek som håndterer KMS planer.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&libliftoff-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &libliftoff-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &libliftoff-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &libliftoff-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &libliftoff-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libliftoff Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="libdrm"/>
    </para>
  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libliftoff</title>

    <para>
      Installer libliftoff ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      For å kjøre testpakken, utsted <command>ninja test</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

