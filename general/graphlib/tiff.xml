<sect1 id="tiff" xreflabel="tiff-&tiff-version;">
  <?dbhtml filename="tiff.html"?>

  <title>tiff-&tiff-version;</title>

  <indexterm zone="tiff">
    <primary sortas="a-tiff">tiff</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til tiff</title>

    <para>
      <application>tiff</application> pakken inneholder TIFF
      biblioteker og tilhørende verktøy. Bibliotekene brukes av mange
      programmer for lesing og skriving av TIFF filer og verktøyene
      brukes til generelt arbeid med TIFF filer.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&tiff-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&tiff-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &tiff-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &tiff-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &tiff-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &tiff-time;
        </para>
      </listitem>
    </itemizedlist>

