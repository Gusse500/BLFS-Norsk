<sect1 id="rnnoise" xreflabel="rnnoise-&rnnoise-version;">
  <?dbhtml filename="rnnoise.html"?>


  <title>rnnoise-&rnnoise-version;</title>

  <indexterm zone="rnnoise">
    <primary sortas="a-rnnoise">rnnoise</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til rnnoise</title>

    <para>
      <application>rnnoise</application> er et støyundertrykkelsesbibliotek 
      basert på et tilbakevendende nevralt nettverk.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&rnnoise-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&rnnoise-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &rnnoise-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &rnnoise-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &rnnoise-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &rnnoise-time;
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av rnnoise</title>

    <para>
      Installer <application>rnnoise</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr \
            --disable-static \
            --docdir=/usr/share/doc/rnnoise-&rnnoise-version; &amp;&amp;
make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

