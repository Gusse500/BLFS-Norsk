  <sect2 role="package">
    <title>Introduksjon til libspelling</title>

    <para>
      <application>libspelling</application> pakken gir
      et GNOME bibliotek for stavekontroll.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&libspelling-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&libspelling-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
