<sect1 id="simdutf" xreflabel="simdutf-&simdutf-version;">
  <?dbhtml filename="simdutf.html"?>

  <title>simdutf-&simdutf-version;</title>

  <indexterm zone="simdutf">
    <primary sortas="a-simdutf">simdutf</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til simdutf</title>

    <para>
      <application>simdutf</application> pakken inneholder et bibliotek som 
      brukes til å behandle Unicode tegn med SIMD optimaliseringer. Dette 
      inkluderer instruksjonssettene SSE2 og AVX2 og mer.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&simdutf-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &simdutf-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &simdutf-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &simdutf-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &simdutf-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">simdutf Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="cmake"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av simdutf</title>

    <para>
      Installer <application>simdutf</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr  \
      -D CMAKE_BUILD_TYPE=Release   \
      -D BUILD_SHARED_LIBS=ON       \
      -G Ninja ..                   &amp;&amp;
ninja</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>ninja test</command>.
      Én test mislykkes fordi den utpakkede tarballen ikke er et git depot.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          fastbase64 og
          sutf8
        </seg>
        <seg>
          libsimdutf.so
        </seg>
        <seg>
          /usr/include/simdutf og
          /usr/lib/cmake/simdutf
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="fastbase64">
        <term><command>fastbase64</command></term>
        <listitem>
          <para>
            koder og dekoder base64 med optimaliseringer
          </para>
          <indexterm zone="simdutf fastbase64">
            <primary sortas="b-fastbase64">fastbase64</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="sutf">
        <term><command>sutf</command></term>
        <listitem>
          <para>
            konverterer kodingen av en inndatafil fra én koding til en annen 
            ved hjelp av simdutf biblioteket
          </para>
          <indexterm zone="simdutf sutf">
            <primary sortas="b-sutf">sutf</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libsimdutf">
        <term><filename class="libraryfile">libsimdutf.so</filename></term>
        <listitem>
          <para>
            inneholder funksjoner som behandler Unicode tegn med SIMD 
            optimaliseringer
          </para>
          <indexterm zone="simdutf libsimdutf">
            <primary sortas="c-libsimdutf">libsimdutf.so</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>
  </sect2>
