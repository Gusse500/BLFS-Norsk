  <sect2 role="package">
    <title>Introduksjon til yyjson</title>

    <para>
      yyjson pakken inneholder et JSON bibliotek med høy ytelse skrevet i C.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&yyjson-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &yyjson-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &yyjson-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &yyjson-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &yyjson-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">yyjson Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="cmake"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="doxygen"/>
    </para>
  </sect2>

  <sect2 role="installation">
    <title>Installasjon av yyjson</title>

    <para>
      Installer yyjson ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D BUILD_SHARED_LIBS=ON      \
      -D YYJSON_BUILD_TESTS=ON     \
      -G Ninja .. &amp;&amp;
ninja</userinput></screen>

    <para>
      For å kjøre testpakken, utsted <command>ninja test</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <parameter>-D YYJSON_BUILD_TESTS=ON</parameter>: Denne parameteren aktiverer 
      bygging av testpakken. Du kan fjerne den hvis du ikke vil kjøre den.
    </para>

  </sect2>

