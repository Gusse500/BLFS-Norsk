        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &utfcpp-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &utfcpp-time;
        </para>
      </listitem>
    </itemizedlist>
