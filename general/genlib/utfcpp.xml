  <sect2 role="package">
    <title>Introduksjon til utfcpp</title>

    <para>
      <application>utfcpp</application> pakken inneholder et sett med
      include filer for å gi UTF-8 med C++ på en Portabel måte.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&utfcpp-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&utfcpp-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &utfcpp-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
