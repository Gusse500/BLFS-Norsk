<sect1 id="libfyaml" xreflabel="libfyaml-&libfyaml-version;">
  <?dbhtml filename="libfyaml.html"?>

  <title>libfyaml-&libfyaml-version;</title>

  <indexterm zone="libfyaml">
    <primary sortas="a-libfyaml">libfyaml</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libfyaml</title>

    <para>
      <application>libfyaml</application> Pakken inneholder en YAML 1.3 
      analyser og skriver. Den støtter også YAML 0.1 ved hjelp av libyaml 
      biblioteket.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&libfyaml-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &libfyaml-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &libfyaml-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &libfyaml-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &libfyaml-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libfyaml Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="libyaml"/> (for YAML 0.1 støtte)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libfyaml</title>

    <para>
      Installer <application>libfyaml</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr --disable-static &amp;&amp;
make</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>make check</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>
