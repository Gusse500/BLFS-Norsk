  <sect2 id="blueprint-compiler" xreflabel="blueprint-compiler-&blueprint-compiler-version;">

    <title>blueprint-compiler-&blueprint-compiler-version;</title>

    <indexterm zone="blueprint-compiler">
      <primary sortas="a-blueprint-compiler">blueprint-compiler</primary>
   </indexterm>

    <sect3 role="package">
      <title>Introduksjon til blueprint-compiler</title>

      <para>
        <application>blueprint-compiler</application> Pakken inneholder en 
        kompilator for et markupspråk for GTK brukergrensesnitt. Dette brukes 
        for tiden mest med GNOME applikasjoner.
      </para>

      &lfs130_checked;

      <bridgehead renderas="sect4">Pakkeinformasjon</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting (HTTP): <ulink url="&blueprint-compiler-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting (FTP): <ulink url="&blueprint-compiler-download-ftp;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting MD5 sum: &blueprint-compiler-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlastingsstørrelse: &blueprint-compiler-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert diskplass som kreves: &blueprint-compiler-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert byggetid: &blueprint-compiler-time;
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">blueprint-compiler Avhengigheter</bridgehead>

      <bridgehead renderas="sect5">Påkrevd</bridgehead>
      <para role="required">
        <xref linkend="pygobject3"/>
      </para>

      <bridgehead renderas="sect5">Valgfri (påkrevd for å kjøre testene)</bridgehead>
      <para role="optional">
        <xref linkend="gtk4"/>
      </para>

      <bridgehead renderas="sect5">Valgfri (påkrevd for å bygge dokumentasjonen)</bridgehead>
      <para role="optional">
        <xref linkend="sphinx"/>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installasjon av blueprint-compiler</title>

      <para>
        Installer <application>blueprint-compiler</application> ved å kjøre 
        følgende kommandoer:
      </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

<!--
      Does not work for me.  I get a timeout on test one after 30 seconds.  - bdubbs
      version 0.20.4

      <para>
        For å kjøre testene, utsted: <command>ninja test</command>. Testene må 
        kjøres i et grafisk miljø, og du må ha
        <xref linkend="gtk4"/> installert.
      </para>
-->
      <para>
        Nå, som &root; bruker:
      </para>

<screen role="root"><userinput>ninja install</userinput></screen>

    </sect3>

    <sect3 role="commands">
      <title>Parameterforklaringer</title>
      
      <para>
        <option>-D docs=true</option>: Bruk dette alternativet hvis du har
        <xref linkend="sphinx"/> installert og du vil bygge 
        dokumentasjonen.
      </para>
    </sect3>

