  <sect2 id="semantic_version" xreflabel="semantic_version-&semantic_version-version;">

    <title>semantic_version-&semantic_version-version;</title>

    <indexterm zone="semantic_version">
      <primary sortas="a-semantic_version">semantic_version</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til semantic_version Modulen</title>

      <para>
        <application>semantic_version</application> modulen bringer et lite 
        bibliotek for å håndtere standard for
        <ulink url="http://semver.org/">Semantic Versioning</ulink> i Python.
      </para>

      &lfs131_checked;

      <bridgehead renderas="sect4">Pakkeinformasjon</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting (HTTP): <ulink url="&semantic_version-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting (FTP): <ulink url="&semantic_version-download-ftp;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting MD5 sum: &semantic_version-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlastingsstørrelse: &semantic_version-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert diskplass som kreves: &semantic_version-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert byggetid: &semantic_version-time;
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">semantic_version Avhengigheter</bridgehead>

      <bridgehead renderas="sect5">Valgfri (for testing)</bridgehead>
      <para role="optional">
        <xref linkend="pytest"/> og
        <ulink url="http://www.djangoproject.com/">Django</ulink>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installasjon av semantic_version</title>

      <para>
        Bygg modulen:
      </para>

&build-wheel;

      <para>
        Nå, som <systemitem class="username">root</systemitem> bruker:
      </para>

<screen role="root"><userinput>&install-wheel; semantic_version</userinput></screen>

      <para>
        For å teste installasjonen, kjør <command>pytest</command>. Det er 
        500+ advarsler på grunn av utdatert syntaks med nyere versjoner av Python.
      </para>

    </sect3>

