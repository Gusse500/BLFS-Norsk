        </seglistitem>
      </segmentedlist>

      <variablelist>
        <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
        <?dbfo list-presentation="list"?>
        <?dbhtml list-presentation="table"?>
        
        <varlistentry id="maturin-prog">
          <term><command>maturin</command></term>
          <listitem>
            <para>
              bygger crates med pyo3, cffi og uniffi bindinger, 
              samt rust binærfiler som Python pakker
            </para>
            <indexterm zone="maturin maturin-prog">
              <primary sortas="b-maturin">maturin</primary>
            </indexterm>
          </listitem>
        </varlistentry>
      </variablelist>
    </sect3>

