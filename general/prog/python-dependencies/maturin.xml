        <seglistitem>
          <seg>maturin</seg>
          <seg>Ingen</seg>
          <seg>
            /usr/lib/python&python3-majorver;/site-packages/maturin og
            /usr/lib/python&python3-majorver;/site-packages/maturin-&maturin-version;.dist-info
