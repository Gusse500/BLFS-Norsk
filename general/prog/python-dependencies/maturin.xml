  <sect2 id="maturin" xreflabel="maturin-&maturin-version;">

    <title>maturin-&maturin-version;</title>

    <indexterm zone="maturin">
      <primary sortas="a-maturin">maturin</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til maturin Modulen</title>

      <para>
        <application>maturin</application> modulen tilbyr et byggesystem for 
        rust binærfiler og crates generert fra Python pakker.
      </para>

      &lfs124_checked;

      <bridgehead renderas="sect4">Pakkeinformasjon</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting (HTTP): <ulink url="&maturin-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting (FTP): <ulink url="&maturin-download-ftp;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting MD5 sum: &maturin-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlastingsstørrelse: &maturin-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert diskplass som kreves: &maturin-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert byggetid: &maturin-time;
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">maturin Avhengigheter</bridgehead>

      <bridgehead renderas="sect5">Påkrevd</bridgehead>
      <para role="required">
        <xref linkend="rust"/> og
        <xref linkend="setuptools_rust"/>
      </para>
    
      <bridgehead renderas="sect5">Valgfri</bridgehead>
      
      <para role="optional">
        <xref linkend="patchelf"/> og
        <ulink url="https://ziglang.org/">zig</ulink>
      </para>
      
      <bridgehead renderas="sect5">Valgfri (for testing)</bridgehead>
      <para role="optional">
        <ulink url="https://pypi.org/project/cffi/">cffi</ulink>,
        <ulink url="https://pypi.org/project/pycparser/">pycparser</ulink>, og
        <ulink url="https://pypi.org/project/virtualenv/">virtualenv</ulink>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installasjon av maturin</title>

      <para>
        Bygg modulen:
      </para>

&build-wheel;

      <para>
        Nå, som <systemitem class="username">root</systemitem> bruker:
      </para>

<screen role="root"><userinput>&install-wheel; maturin</userinput></screen>

      <para>
        For å teste installasjonen, utsted:
      </para>

<screen remap="test"><userinput>python3 -m venv --system-site-packages testenv     &amp;&amp;
testenv/bin/pip3 install cffi pycparser virtualenv &amp;&amp;
PATH=$PWD/testenv/bin:$PATH cargo test</userinput></screen>

      <para>
        Tre tester, <filename>integration_cffi_mixed</filename>,
        <filename>pyo3_mixed_include_exclude_sdist</filename>, og
        <filename>pyo3_no_extension_module</filename>, er kjent for å mislykkes.
      </para>

    </sect3>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="../../../xincludes/pip3-cmd-explain.xml"/>

    <sect3 role="content">
      <title>Innhold</title>

