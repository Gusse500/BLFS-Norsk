  <sect2 id="uv_build" xreflabel="uv_build-&uv_build-version;">

    <title>uv_build-&uv_build-version;</title>

    <indexterm zone="uv_build">
      <primary sortas="a-uv_build">uv_build</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til uv_build Modulen</title>

      <para>
        <application>uv_build</application> modulen tilbyr PEP 517 
        byggebakstykket fra Python pakkehåndteringssystemet 'uv'.
      </para>

      &lfs124_checked;

      <bridgehead renderas="sect4">Pakkeinformasjon</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting (HTTP): <ulink url="&uv_build-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting (FTP): <ulink url="&uv_build-download-ftp;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting MD5 sum: &uv_build-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlastingsstørrelse: &uv_build-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert diskplass som kreves: &uv_build-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert byggetid: &uv_build-time;
          </para>
        </listitem>
      </itemizedlist>

