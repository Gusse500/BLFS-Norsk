  <sect2 id="tomlkit" xreflabel="tomlkit-&tomlkit-version;">

    <title>Tomlkit-&tomlkit-version;</title>

    <indexterm zone="tomlkit">
      <primary sortas="a-tomlkit">tomlkit</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til Tomlkit Modulen</title>

      <para>
        <application>Tomlkit</application> er et utvidbart, standardkompatibelt 
        byggebackend for Python moduler.
      </para>

      &lfs131_checked;

      <bridgehead renderas="sect4">Pakkeinformasjon</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting (HTTP): <ulink url="&tomlkit-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting (FTP): <ulink url="&tomlkit-download-ftp;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting MD5 sum: &tomlkit-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlastingsstørrelse: &tomlkit-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert diskplass som kreves: &tomlkit-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert byggetid: &tomlkit-time;
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">Tomlkit Avhengigheter</bridgehead>

      <bridgehead renderas="sect5">Påkrevd</bridgehead>
      <para role="required">
        <xref linkend="poetry-core"/>
      </para>

      <bridgehead renderas="sect5">Valgfri (for tester) </bridgehead>
      <para role="optional">
        <xref linkend="pytest"/> og
        <ulink url="https://pypi.org/project/pytest-cov/">pytest-cov</ulink>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installasjon av Tomlkit</title>

    <para>Bygg modulen: </para>

&build-wheel;

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>&install-wheel; tomlkit</userinput></screen>

    <para>
      For å teste installasjonen, sørg for at <xref linkend='pytest'/>
      er installert, så 
      utsted:
    </para>

<screen remap="test"><userinput>python3 -m venv --system-site-packages testenv &amp;&amp;
testenv/bin/pip3 install pytest-cov            &amp;&amp;
testenv/bin/python -m pytest</userinput></screen>

    </sect3>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="../../../xincludes/pip3-cmd-explain.xml"/>

    <sect3 role="content">
      <title>Innhold</title>

      <segmentedlist>
        <segtitle>Installerte Programmer</segtitle>
        <segtitle>Installerte Biblioteker</segtitle>
        <segtitle>Installerte Mapper</segtitle>

        <seglistitem>
          <seg>Ingen</seg>
          <seg>Ingen</seg>
