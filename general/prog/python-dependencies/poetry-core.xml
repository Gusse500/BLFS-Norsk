  <sect2 id="poetry-core" xreflabel="poetry-core-&poetry-core-version;">

    <title>Poetry-core-&poetry-core-version;</title>

    <indexterm zone="poetry-core">
      <primary sortas="a-poetry-core">poetry-core</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til Poetry-core Module</title>

      <para>
        <application>Poetry-core</application> er et utvidbart, 
        standardkompatibelt byggebackend for Python moduler.
      </para>

      &lfs131_checked;

      <bridgehead renderas="sect4">Pakkeinformasjon</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting (HTTP): <ulink url="&poetry-core-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting (FTP): <ulink url="&poetry-core-download-ftp;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting MD5 sum: &poetry-core-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlastingsstørrelse: &poetry-core-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert diskplass som kreves: &poetry-core-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert byggetid: &poetry-core-time;
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">Poetry-core Avhengigheter</bridgehead>

      <bridgehead renderas="sect5">Valgfri (for tester)</bridgehead>
      <para role="optional">
        <xref linkend="pytest"/>,
        <xref linkend="pypa-build"/>,
        <ulink url="https://pypi.org/project/pytest-cov/">pytest-cov</ulink>,
        <ulink url="https://pypi.org/project/pytest-mock/">pytest-mock</ulink>, og
        <ulink url="https://pypi.org/project/virtualenv/">virtualenv</ulink>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installasjon av Poetry-core</title>

    <para>Bygg modulen: </para>

&build-wheel;

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>&install-wheel; poetry-core</userinput></screen>

    <para>
      For å teste installasjonen, sørg for at <xref linkend='pytest'/> og
      <xref linkend='pypa-build'/> er
      installert, deretter utsted:
    </para>

<screen remap="test"><userinput>python3 -m venv --system-site-packages testenv                &amp;&amp;
testenv/bin/pip3 install pytest-{cov,mock} tomli-w virtualenv &amp;&amp;
testenv/bin/python -m pytest</userinput></screen>

    </sect3>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="../../../xincludes/pip3-cmd-explain.xml"/>

