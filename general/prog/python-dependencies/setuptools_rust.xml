          </para>
        </listitem>
        <listitem>
          <para>
            Nedlasting MD5 sum: &setuptools_rust-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Nedlastingsstørrelse: &setuptools_rust-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert diskplass som kreves: &setuptools_rust-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimert byggetid: &setuptools_rust-time;
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">setuptools_rust Avhengigheter</bridgehead>

      <bridgehead renderas="sect5">Påkrevd</bridgehead>
      <para role="required">
        <xref linkend="semantic_version"/>
      </para>

      <bridgehead renderas="sect5">Valgfri (for testing)</bridgehead>
      <para role="optional">
        <xref linkend="pytest"/>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installasjon av setuptools_rust</title>

      <para>
        Bygg modulen:
      </para>

&build-wheel;

      <para>
        Nå, som <systemitem class="username">root</systemitem> bruker:
      </para>

<screen role="root"><userinput>&install-wheel; setuptools_rust</userinput></screen>

      <para>
        For å teste installasjonen, utsted:
        <command>pytest --doctest-modules setuptools_rust tests</command>. Én 
        advarsel vil vises om en API avvikling.
      </para>

    </sect3>

