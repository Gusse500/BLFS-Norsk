  <sect2 id="setuptools_rust" xreflabel="setuptools_rust-&setuptools_rust-version;">

    <title>setuptools_rust-&setuptools_rust-version;</title>

    <indexterm zone="setuptools_rust">
      <primary sortas="a-setuptools_rust">setuptools_rust</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til setuptools_rust Modulen</title>

      <para>
        <application>setuptools_rust</application> modulen tilbyr et programtillegg 
        til setuptools som tillater kompilering av Python utvidelser i Rust.
      </para>

      &lfs124_checked;

      <bridgehead renderas="sect4">Pakkeinformasjon</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting (HTTP): <ulink url="&setuptools_rust-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
