    <primary sortas="a-seatd">seatd</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til seatd</title>

    <para>
      seatd pakken tilbyr et universelt bibliotek for seat håndtering. Det er 
      det mange Wayland kompositore bruker for å administrere seater, en økt for 
      en bruker som applikasjoner kan samhandle med. Den kan eventuelt tilby sin 
      egen seat håndtering som et alternativ til en logind variant, men 
      instruksjonene som gis vil bruke den som en shim, som <phrase
      revision="sysv">e</phrase>logind <phrase revision="systemd"> fra <xref
      linkend="systemd"/></phrase> vil være den underliggende seat behandleren.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&seatd-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &seatd-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &seatd-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &seatd-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &seatd-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">seatd Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <phrase revision="sysv"><xref linkend="elogind"/></phrase>
      <phrase revision="systemd"><xref linkend="systemd"/></phrase>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av seatd</title>
    <para>
      Installer seatd ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr             \
            --buildtype=release       \
            -D server=disabled        \
            -D libseat-seatd=disabled \
            .. &amp;&amp;

ninja</userinput></screen>

    <para>
      For å kjøre testpakken, utsted: <command>ninja test</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <parameter>-D server=disabled</parameter>: Deaktiverer bygging av 
      seatd daemonen.
    </para>

    <para>
      <parameter>-D libseat-seatd=disabled</parameter>: Denne parameteren 
      deaktiverer å bygge støtte for seatd administrasjonsdaemonen for
      <filename class="libraryfile">libseat.so</filename> og er i stedet 
      avhengig av det systeminstallerte <phrase revision="sysv">e</phrase>logind i stedet.
    </para>

  </sect2>

