<!-- Try to keep the indentation used in this file-->
<sect1 id="libde265" xreflabel="libde265-&libde265-version;">
  <?dbhtml filename="libde265.html"?>

  <title>libde265-&libde265-version;</title>

  <indexterm zone="libde265">
    <primary sortas="a-libde265">libde265</primary>
  </indexterm>

  <!--Required section-->
  <sect2 role="package">
    <title>Introduksjon til libde265</title>

    <para>
      <application>libde265</application> pakken inneholder en åpen kildekode 
      H.265 videokodek implementering.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&libde265-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &libde265-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &libde265-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &libde265-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &libde265-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libde265 Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="cmake"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="sdl2"/>
      (for YUV støtte for overleggsutdata <command>dec265</command>),
      både <ulink url="https://&lfs-domainname;/blfs/view/12.2/x/qt5-components.html">Qt 5</ulink> og <xref linkend="ffmpeg"/>
      (for bygging av <command>sherlock265</command>)
    </para>

    <!--  Only use this if you want to note something in the wiki
    <para condition="html" role="usernotes">
      Redaktørens merknader: <ulink url="&blfs-wiki;/libde265"/>
    </para>
    -->
  </sect2>

  <!--Required section-->
  <sect2 role="installation">
    <title>Installasjon av libde265</title>

    <para>
      Installer <application>libde265</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      .. &amp;&amp;
make</userinput></screen>

    <!-- The README.md file mentions a "testdata" directory but I cannot
         find it in the tarball.  -->
    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>
  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installert Programm</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installert Mappe</segtitle>

      <seglistitem>
        <seg>
          dec265
        </seg>
        <seg>
          libde265.so
        </seg>
        <seg>
          /usr/include/libde265
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="dec265">
        <term><command>dec265</command></term>
        <listitem>
          <para>
            en dekoder H.265-data (rå bitstrøm av en strøm med NAL enheter)
          </para>
          <indexterm zone="libde265 dec265">
            <primary sortas="b-dec265">dec265</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libde265-lib">
        <term><filename class="libraryfile">libde265.so</filename></term>
        <listitem>
          <para>
            inneholder en H.265 videodekoder
          </para>
          <indexterm zone="libde265 libde265-lib">
            <primary sortas="c-libde265">libde265.so</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>
  </sect2>
</sect1>
