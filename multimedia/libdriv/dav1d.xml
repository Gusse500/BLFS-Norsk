  <sect2 role="package">
    <title>Introduksjon til dav1d</title>

    <para>
      dav1d pakken inneholder en AV1 dekoder.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&dav1d-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&dav1d-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &dav1d-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &dav1d-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &dav1d-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &dav1d-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">dav1d Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="Recommended">
      <xref linkend="nasm"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av dav1d</title>

    <para>
      Installer dav1d ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      For å teste resultatene, kjør <command>ninja test</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

