<sect1 id="gnome-text-editor" xreflabel="gnome-text-editor-&gnome-text-editor-version;">
  <?dbhtml filename="gnome-text-editor.html"?>


  <title>gnome-text-editor-&gnome-text-editor-version;</title>

  <indexterm zone="gnome-text-editor">
    <primary sortas="a-gnome-text-editor">gnome-text-editor</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til gnome-text-editor</title>

    <para>
      <application>gnome-text-editor</application> er en enkel tekstredigerer
      som fokuserer på øktbehandling. Det jobber hardt for å holde styr på
      endringer og status selv om du avslutter applikasjonen. Du kan komme
      tilbake til arbeidet ditt selv om du aldri har lagret den til en fil.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&gnome-text-editor-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&gnome-text-editor-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting MD5 sum: &gnome-text-editor-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlastingsstørrelse: &gnome-text-editor-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert diskplass som kreves: &gnome-text-editor-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimert byggetid: &gnome-text-editor-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">gnome-text-editor Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="appstream"/>,
      <xref linkend="editorconfig-core-c"/>,
      <xref linkend="gtksourceview5"/>, 
      <xref linkend="libadwaita1"/>,
      <xref linkend="libspelling"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="itstool"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av gnome-text-editor</title>

    <para>
      Installer <application>gnome-text-editor</application> ved å kjøre
      følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup ..            \
      --prefix=/usr       \
      --buildtype=release &amp;&amp;

ninja</userinput></screen>

    <para>
      For å teste resultatene, kjør: <command>ninja test</command>,
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>
