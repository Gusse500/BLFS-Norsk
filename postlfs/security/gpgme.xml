  <sect2 role="installation">
    <title>Installasjon av gpgme</title>

    <para>
      Installer <application>gpgme</application> ved å kjøre følgende
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

../configure --prefix=/usr --disable-static    &amp;&amp;
make</userinput></screen>

    <para>
      For å teste resultatene, bør du ha <xref linkend="gnupg2"/>
      installerte. I så fall, kjør:
    </para>

<screen remap='test'><userinput>make -k check</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="../../xincludes/static-libraries.xml"/>

    <para>
      <option>--disable-gpg-test</option>: Bruk denne bryteren hvis
      <xref linkend="gnupg2"/> ikke er installert.
    </para>

  </sect2>
  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installert Program</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installert Mappe</segtitle>

      <seglistitem>
        <seg>
          gnupg-key-manage, gpgme-json, og gpgme-tool
        </seg>
        <seg>
          libgpgme.so
        </seg>
        <seg>
          /usr/share/common-lisp/source/gpgme
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="gnupg-key-manage">
        <term><command>gnupg-key-manage</command></term>
        <listitem>
          <para>
            utfører en rekke operasjoner på GPG nøkler, inkludert å 
            identifisere nøkler og slette dem
          </para>
          <indexterm zone="gpgme gnupg-key-manage">
            <primary sortas="b-gnupg-key-manage">gnupg-key-manage</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="gpgme-json">
        <term><command>gpgme-json</command></term>
        <listitem>
          <para>
            sender <application>gpgme</application> kommandoer i JSON format
          </para>
          <indexterm zone="gpgme gpgme-json">
            <primary sortas="b-gpgme-json">gpgme-json</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="gpgme-tool">
        <term><command>gpgme-tool</command></term>
        <listitem>
          <para>
            er en assuan server som avslører <application>gpgme</application>
            operasjoner, slik som å skrive ut fingeravtrykk og nøkkelkoder med
            nøkkelservere
          </para>
          <indexterm zone="gpgme gpgme-tool">
            <primary sortas="b-gpgme-tool">gpgme-tool</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libgpgme">
        <term><filename class="libraryfile">libgpgme.so</filename></term>
        <listitem>
          <para>
            inneholder <application>gpgme</application> API funksjoner
          </para>
          <indexterm zone="gpgme libgpgme">
            <primary sortas="c-libgpgme">libgpgme.so</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
